{
  "name": "taskboard",
  "version": "0.1.0",
  "description": "Kanban boards with an embedded calendar",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV=1 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && electron ."
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "svelte": "^5.0.0",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
